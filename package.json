{
  "name": "moneypulse-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "deploy": "firebase deploy",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/validate-ai-customizations.mjs && npx markdownlint-cli2 --no-globs AGENTS.md '.github/**/*.md' 'docs/agentic/**/*.md' 'specs/**/*.md'"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-builder": ">=1.1.7",
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "@tootallnate/once": ">=3.0.1",
      "protobufjs": ">=8.6.6",
      "@protobufjs/utf8": ">=1.1.1",
      "brace-expansion": ">=5.0.11",
      "ws": ">=8.20.1",
      "qs": ">=6.16.0",
      "websocket-driver": ">=0.7.5",
      "@fastify/busboy": ">=3.2.1",
      "@grpc/grpc-js": ">=1.14.5",
      "browserslist": ">=4.28.7",
      "form-data": ">=2.5.6",
      "nanoid": ">=3.3.18",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "vite": ">=8.1.6",
      "proxy-addr": ">=2.0.8",
      "body-parser": ">=1.20.9",
      "node-forge": ">=1.4.1",
      "@vitest/mocker": "^4.1.12",
      "baseline-browser-mapping": ">=2.11.0",
      "@babel/core": ">=7.29.6"
    }
  }
}
