rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny — every collection must have an explicit rule below.
    match /{document=**} {
      allow read, write: if false;
    }

    // User root document — explicitly protected (not covered by {document=**} wildcard
    // which only matches one or more path segments, not zero).
    match /users/{userAliasId} {
      allow read, write: if request.auth != null && request.auth.uid == userAliasId;
    }

    // Cloud-only overlays — user-owned personalization (preferences, saved filters, etc.)
    match /users/{userAliasId}/overlays/{overlayId} {
      allow read, write: if request.auth != null && request.auth.uid == userAliasId;
    }

    // Device tokens — browser writes FCM token on registration, reads own tokens only
    match /users/{userAliasId}/deviceTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userAliasId;
    }

    // Projected notifications — written by ingestSyncEvent (Admin SDK), browser may
    // only read and mark isRead. No create or delete from browser.
    match /users/{userAliasId}/notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == userAliasId;
      allow update: if request.auth != null
        && request.auth.uid == userAliasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // Sync ingress events — written exclusively by Cloud Functions (Admin SDK bypasses
    // these rules). Field existence check ensures missing-field docs fail closed.
    match /syncIngressEvents/{eventId} {
      allow read: if request.auth != null
                  && ('userAliasId' in resource.data)
                  && resource.data.userAliasId == request.auth.uid;
      allow write: if false;
    }

    // Projected transactions — read-only from browser, written by sync function only.
    match /transactions/{txnId} {
      allow read: if request.auth != null && resource.data.userAliasId == request.auth.uid;
      allow write: if false;
    }

    // Projected categories — read-only from browser, written by sync function only.
    match /categories/{catId} {
      allow read: if request.auth != null && resource.data.userAliasId == request.auth.uid;
      allow write: if false;
    }

    // Projected budgets — read-only from browser, written by sync function only.
    match /budgets/{budgetDocId} {
      allow read: if request.auth != null && resource.data.userAliasId == request.auth.uid;
      allow write: if false;
    }

    // Projected AI metrics — one aggregate doc per user alias, read-only from browser.
    match /aiMetrics/{userAliasId} {
      allow read: if request.auth != null && request.auth.uid == userAliasId;
      allow write: if false;
    }
  }
}
